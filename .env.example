# Supabase Configuration
# احصل على هذه القيم من لوحة تحكم مشروعك في Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# مفتاح الخدمة للإدارة (اختياري / للخادم فقط)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenFDA API Configuration (اختياري لزيادة سعة الطلبات)
OPENFDA_API_KEY=
OPENFDA_API_BASE_URL=https://api.fda.gov/drug/ndc.json
